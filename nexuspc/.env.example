# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Chargily (online payments)
# ---------------------------------------------------------------------------
CHARGILY_API_KEY=your-chargily-api-key
CHARGILY_WEBHOOK_SECRET=your-chargily-webhook-secret

# ---------------------------------------------------------------------------
# Cloudinary (image uploads)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---------------------------------------------------------------------------
# Cloudflare R2 (file storage — alternative to Cloudinary)
# ---------------------------------------------------------------------------
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ---------------------------------------------------------------------------
# Groq (AI features)
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
